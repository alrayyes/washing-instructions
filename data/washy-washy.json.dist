    },
    {
      "clothing_type": "Denim",
      "detergent": "Liquid detergent for dark/black",
      "fabric_softener": "no",
      "temperature": "30",
      "spin": "800",
      "duration": "~2:00",
      "program": "Cottons",
      "options": "Extra Rinse",
      "ironing": "yes",
      "ironing_notes": "Inside out on cotton heat if you want them crisp. Steam.",
      "iron_setting": "3",
      "drying": "Hang by the waistband and air dry. A hot dryer shrinks them and destroys the elastane in stretch denim.",
      "colour_group": "dark",
      "mix_tags": "dye-bleeder",
      "notes": "Inside out, zips and buttons closed. Wash them far less often than you think.",
      "reference_name": "",
      "reference_link": ""
    },
    {
      "clothing_type": "Raw Denim",
      "detergent": "A capful of pH-neutral or denim-specific detergent. No bleach, no enzymes.",
      "fabric_softener": "no",
      "temperature": "cold",
      "spin": "400",
      "duration": "~0:45",
      "program": "Delicates / Silk",
      "options": "",
      "ironing": "no",
      "ironing_notes": "Pressing sets creases in the wrong places and flattens the fades that took months to earn.",
      "iron_setting": "",
      "drying": "Hang inside out indoors, away from sun and radiators. Never tumble.",
      "colour_group": "dark",
      "mix_tags": "solo|dye-bleeder",
      "notes": "Unwashed denim is meant to go months before its first wash. Gentler than the machine: a 45-minute cold soak in the bath, inside out, no agitation, no wringing — then roll in a towel to press the water out.",
      "reference_name": "",
      "reference_link": ""
    },
    {
      "clothing_type": "Merino Wool",
      "detergent": "Wool detergent, half dose. No enzymes, no proteases, no bleach — they eat the fibre.",
      "fabric_softener": "no",
      "temperature": "30",
      "spin": "400",
      "duration": "~0:40",
      "program": "Wool",
      "options": "",
      "ironing": "yes",
      "ironing_notes": "Only if you must: pressing cloth, no weight. Hanging it in a steamy bathroom drops the creases without touching it.",
      "iron_setting": "2",
      "drying": "Never tumble dry. Dry flat on a towel, away from radiators and sun — hung up it stretches and never comes back.",
      "colour_group": "any",
      "mix_tags": "",
      "notes": "Turn inside out, wash with wool only, nothing with zips. Merino barely needs washing — air it overnight and wear it again.",
      "reference_name": "Icebreaker on merino",
      "reference_link": "https://eu.icebreaker.com/en-gb/blogs/journal/how-to-wash-merino-wool-jumper"
    },
    {
      "clothing_type": "Synthetic Activewear",
      "detergent": "A small dose of mild pH-neutral liquid detergent. Too much is what makes them smell.",
      "fabric_softener": "no",
      "temperature": "30",
      "spin": "800",
      "duration": "~1:10",
      "program": "Sportswear",
      "options": "Extra Rinse",
      "ironing": "no",
      "ironing_notes": "Elastane starts degrading around 110 °C, and the technical finish goes with it.",
      "iron_setting": "",
      "drying": "Air dry on a hanger — dry within the hour. Tumble heat kills the stretch.",
      "colour_group": "sport",
      "mix_tags": "lint-magnet",
      "notes": "Inside out. Never softener: it films over the fibres these rely on for wicking and stretch. A cup of white vinegar in the rinse resets a load that already smells. Covers tops, shorts and base layers — one fabric family, one wash. Mixed colours are fine in one run: at 30 °C the dyes on polyester barely move. The exception is a brand-new black or strong red piece, which can crock for a wash or two — give that its own run first.",
      "reference_name": "Dirty Labs on synthetic activewear",
      "reference_link": "https://dirtylabs.com/blogs/the-dirt/how-to-wash-your-activewear"
    },
    {
      "clothing_type": "Gym Socks",
      "detergent": "Liquid detergent, normal dose",
      "fabric_softener": "no",
      "temperature": "40",
      "spin": "1200",
      "duration": "~1:20",
      "program": "Sportswear",
      "options": "Extra Rinse",
      "ironing": "no",
      "ironing_notes": "",
      "iron_setting": "",
      "drying": "Tumble dry low or line dry.",
      "colour_group": "sport",
      "mix_tags": "lint-shedder",
      "notes": "Give them a 60 °C cotton run every few weeks — 40 °C keeps them clean but doesn't reset the smell.",
      "reference_name": "",
      "reference_link": ""
    },
    {
      "clothing_type": "Cashmere Blend",
      "detergent": "Wool or cashmere detergent, half dose. No enzymes, no proteases, no bleach.",
      "fabric_softener": "no",
      "temperature": "30",
      "spin": "400",
      "duration": "~0:40",
      "program": "Wool",
      "options": "",
      "ironing": "yes",
      "ironing_notes": "Low heat through a pressing cloth. Better still, steam it on a hanger and let the creases drop out on their own.",
      "iron_setting": "2",
      "drying": "Never tumble dry. Squeeze the water out, never wring, then dry flat on a towel away from any heat.",
      "colour_group": "any",
      "mix_tags": "",
      "notes": "Inside out, and only ever with other wool. Cashmere pills where it rubs — that is the fibre behaving normally, not a fault; a cashmere comb takes it off. Check the blend first: a little nylon makes it tougher, silk makes it more delicate.",
      "reference_name": "",
      "reference_link": ""
    },
    {
      "clothing_type": "Wool Trainers",
      "detergent": "A small amount of mild detergent — a wool detergent is ideal. No bleach.",
      "fabric_softener": "no",
      "temperature": "cold",
      "spin": "400",
      "duration": "~0:40",
      "program": "Wool",
      "options": "",
      "ironing": "no",
      "ironing_notes": "",
      "iron_setting": "",
      "drying": "Air dry only, somewhere with moving air: outside, by a window, or in front of a fan. Never the dryer and never a radiator — heat warps the sole and shrinks the wool upper.",
      "colour_group": "any",
      "mix_tags": "solo",
      "notes": "Pull the insoles and laces out first and wash those by hand. The shoes go in a mesh delicates bag or a pillowcase, on their own — a loose trainer batters the drum and everything in it.",
      "reference_name": "",
      "reference_link": ""
    },
    {
      "clothing_type": "Linen",
      "detergent": "Mild liquid detergent, no bleach — bleach yellows linen and breaks the fibre down over time",
      "fabric_softener": "no",
      "temperature": "40",
      "spin": "800",
      "duration": "~1:30",
      "program": "Easy Care",
      "options": "Easy Iron",
      "ironing": "yes",
      "ironing_notes": "While still damp, hottest setting, steam first.",
      "iron_setting": "max",
      "drying": "Line dry, or tumble low and pull out a little damp — bone dry locks creases in.",
      "colour_group": "any",
      "mix_tags": "",
      "notes": "New linen sheds a little dye/lint for the first few washes — wash alone until it rinses clear, then fine with other 40 °C loads.",
