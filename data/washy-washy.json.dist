    {
      "clothing_type": "White Towels",
      "detergent": "Universal powder, full dose. Go lighter rather than heavier: excess detergent stiffens terry.",
      "fabric_softener": "no",
      "temperature": "60",
      "spin": "1400",
      "duration": "~2:30",
      "program": "Cottons",
      "options": "Extra Rinse",
      "ironing": "no",
      "ironing_notes": "Ironing crushes the pile flat and the towel stops drying you.",
      "iron_setting": "",
      "drying": "Tumble dry medium — the tumbling is what fluffs the pile back up.",
      "colour_group": "white",
      "mix_tags": "lint-shedder",
      "notes": "Never fabric softener: it coats the loops in silicone and the towel stops absorbing. White vinegar in the softener drawer once a month softens instead.",
      "reference_name": "",
      "reference_link": ""
    },
    {
      "clothing_type": "Coloured",
