{
  "$schema": "https://cdn.jsdelivr.net/npm/@washy-washy/core/schema/config.schema.json",
  "machine": {
    "washer": {
      "name": "Generic front loader",
      "capacity": "1–8 kg",
      "programs": [
        "Off",
        "Cottons",
        "Cottons + Prewash",
        "Easy Care",
        "Easy Care + Prewash",
        "Quick Mixed",
        "Delicates / Silk",
        "Wool",
        "Rinse / Spin",
        "Drain",
        "Gentle Spin",
        "Super Quick 15'",
        "Easy Care Special",
        "Extra Delicate",
        "Sportswear",
        "Allergy Plus"
      ],
      "temperatures": [
        "cold",
        "20",
        "30",
        "40",
        "60",
        "90"
      ],
      "spins": [
        "0",
        "400",
        "600",
        "800",
        "1200",
        "1400"
      ],
      "options": [
        "Speed",
        "Eco",
        "Easy Iron",
        "Extra Rinse"
      ]
    },
    "iron": {
      "name": "Generic steam iron",
      "settings": [
        {
          "key": "min",
          "dots": "",
          "label": "MIN",
          "detail": "no heat",
          "steam": false
        },
        {
          "key": "1",
          "dots": "•",
          "label": "•",
          "detail": "synthetics · 110 °C",
          "steam": false
        },
        {
          "key": "2",
          "dots": "••",
          "label": "••",
          "detail": "wool, silk · 150 °C",
          "steam": true
        },
        {
          "key": "3",
          "dots": "•••",
          "label": "•••",
          "detail": "cotton, linen · 200 °C",
          "steam": true
        },
        {
          "key": "max",
          "dots": "•••",
          "label": "MAX",
          "detail": "linen · 230 °C",
          "steam": true
        }
      ]
    }
  },
  "chart": [
    {
      "clothing_type": "White",
      "detergent": "Universal powder, full dose — the bleach in powder is what keeps whites from going grey",
      "fabric_softener": "no",
      "temperature": "60",
      "spin": "1200",
      "duration": "~2:30",
      "program": "Cottons",
      "options": "Eco",
      "ironing": "yes",
      "ironing_notes": "Iron while slightly damp, steam on. Cotton takes all the heat the iron has.",
      "iron_setting": "3",
      "drying": "Tumble dry normal, or line dry in the sun — sunlight bleaches whites for free.",
      "colour_group": "white",
      "mix_tags": "",
      "notes": "Wash whites on their own. One stray coloured sock is all it takes.",
      "reference_name": "",
      "reference_link": ""
    },
