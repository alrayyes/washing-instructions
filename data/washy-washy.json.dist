    {
      "clothing_type": "Coloured Towels",
      "detergent": "Colour liquid detergent. Go lighter rather than heavier: excess detergent stiffens terry.",
      "fabric_softener": "no",
      "temperature": "40",
      "spin": "1400",
      "duration": "~2:15",
      "program": "Cottons",
      "options": "Extra Rinse",
      "ironing": "no",
      "ironing_notes": "Ironing crushes the pile flat and the towel stops drying you.",
      "iron_setting": "",
      "drying": "Tumble dry medium — the tumbling is what fluffs the pile back up.",
      "colour_group": "colour",
      "mix_tags": "lint-shedder",
      "notes": "Never fabric softener — it kills absorbency. Run them at 60 °C every month or so if they start to smell.",
      "reference_name": "",
      "reference_link": ""
    },
    {
      "clothing_type": "Microfibre Towels",
      "detergent": "Liquid detergent, half dose. What doesn't rinse away stays in the split fibre and stops it picking anything up.",
      "fabric_softener": "no",
      "temperature": "40",
      "spin": "1200",
      "duration": "~1:30",
      "program": "Easy Care",
      "options": "Extra Rinse",
      "ironing": "no",
      "ironing_notes": "Polyester and polyamide start melting around 110 °C, well before the iron does anything useful.",
      "iron_setting": "",
      "drying": "Air dry, or tumble on low. High heat fuses the split ends shut and the towel never absorbs again.",
      "colour_group": "colour",
      "mix_tags": "lint-magnet",
      "notes": "Never fabric softener — it fills the split fibres with silicone and the towel is finished. Wash with microfibre only: the same split ends that make it absorbent grab cotton lint and never let go.",
      "reference_name": "",
      "reference_link": ""
    },
    {
      "clothing_type": "Dark",
      "detergent": "Liquid detergent for dark/black — optical brighteners are what leave that grey haze",
      "fabric_softener": "no",
      "temperature": "30",
      "spin": "800",
      "duration": "~2:00",
      "program": "Cottons",
      "options": "Extra Rinse",
      "ironing": "yes",
      "ironing_notes": "Inside out, medium heat. Steam, don't press hard — shine on dark cotton doesn't come out.",
      "iron_setting": "2",
      "drying": "Line dry inside out, out of direct sun. Skip the dryer: heat fades black fastest.",
      "colour_group": "dark",
      "mix_tags": "dye-bleeder",
      "notes": "Turn everything inside out. The extra rinse matters here — detergent residue dries as grey streaks on black.",
      "reference_name": "",
      "reference_link": ""
    },
