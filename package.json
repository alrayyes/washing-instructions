{
  "name": "washing-instructions",
  "version": "0.0.0",
  "description": "Turns a CSV of laundry piles into a phone PDF and a printable PDF, drawn for one specific washing machine and iron.",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format:md": "prettier --write \"**/*.md\"",
    "lint:md": "prettier --check \"**/*.md\" && markdownlint-cli2 \"**/*.md\"",
    "check": "bun run lint && bun run lint:md && bun run typecheck && bun test"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.6.0",
    "csv-parse": "7.0.2",
    "pdf-lib": "1.17.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
