{
  "name": "washing-instructions",
  "version": "0.0.0",
  "description": "Turns a CSV of laundry piles into a phone PDF and a printable PDF, drawn for one specific washing machine and iron.",
  "type": "module",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "prepare": "lefthook install",
    "generate": "bun run src/cli.ts",
    "test": "bun test",
    "schema": "bun run scripts/csv-schema.ts",
    "lint:data": "bun run scripts/validate-csv.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "prettier --write .",
    "lint:md": "prettier --check \"**/*.md\" && markdownlint-cli2 \"**/*.md\"",
    "lint:yaml": "prettier --check \"**/*.{yml,yaml}\"",
    "prose:sync": "bun run scripts/install-vale.ts && .tools/vale sync",
    "lint:prose": ".tools/vale --glob='!{styles/**,CHANGELOG.md}' --minAlertLevel=error .",
    "lint:prose:advice": ".tools/vale --glob='!{styles/**,CHANGELOG.md}' .",
    "check": "bun run lint && bun run lint:md && bun run lint:yaml && bun run lint:prose && bun run lint:data && bun run typecheck && bun test"
  },
  "trustedDependencies": [
    "lefthook"
  ],
  "dependencies": {
    "@react-pdf/renderer": "4.6.0",
    "csv-parse": "7.0.2",
    "pdf-lib": "1.17.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  }
}
