{
  "name": "washy-washy",
  "version": "0.0.0",
  "private": true,
  "description": "Turns a CSV of laundry piles into a phone PDF and a printable PDF, drawn for one specific washing machine and iron.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run lint && bun run lint:md && bun run lint:yaml && bun run lint:prose && bun run typecheck && bun test",
    "examples": "bun run src/cli.ts data/washy-washy.json.dist --out docs",
    "format": "prettier --write .",
    "generate": "bun run src/cli.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:md": "prettier --check \"**/*.md\" && markdownlint-cli2 \"**/*.md\"",
    "lint:prose": ".tools/vale --glob='!{styles/**,CHANGELOG.md}' --minAlertLevel=error .",
    "lint:prose:advice": ".tools/vale --glob='!{styles/**,CHANGELOG.md}' .",
    "lint:yaml": "prettier --check \"**/*.{yml,yaml}\"",
    "migrate-config": "bun run scripts/migrate-config.ts",
    "prepare": "lefthook install",
    "prose:sync": "bun run scripts/install-vale.ts && .tools/vale sync",
    "screenshots": "bun run scripts/screenshots.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@washy-washy/core": "workspace:*",
    "@washy-washy/pdf": "workspace:*",
    "csv-parse": "7.0.2",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "lefthook"
  ]
}
