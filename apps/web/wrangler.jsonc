{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Confirm this matches the Workers project name shown in the Cloudflare
  // dashboard — `wrangler deploy` targets whatever project this name
  // resolves to, and a mismatch either fails or, worse, creates a second
  // project instead of deploying to the one already set up.
  "name": "washy-washy",
  "compatibility_date": "2026-08-21",
  // No Worker script: this is a static site, served entirely from the
  // Astro build's output. Static-only Workers still need a
  // compatibility_date, but nothing here ever runs server-side code.
  "assets": {
    "directory": "./dist"
  }
}
