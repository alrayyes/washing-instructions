---
// Same static import pattern as index.astro — see that file's comment on
// why Vite's `?raw` import is used over a runtime file read.
import machineSource from "../../../../data/machine.json.dist?raw";
import csvSource from "../../../../data/washing-instructions.csv.dist?raw";
import ConfigViewer from "../components/ConfigViewer";
import Layout from "../layouts/Layout.astro";
import { buildChart } from "../lib/chart";

const { items, machine } = buildChart(csvSource, machineSource);
---

<Layout
  title="Washy washy — config"
  description="The full loaded config: the washing machine and iron's settings, and every pile in the chart, in one structured place."
>
  <h1 class="mb-6 text-2xl font-bold text-ink sm:text-3xl">Config</h1>
  <ConfigViewer client:load items={items} machine={machine} />
</Layout>
