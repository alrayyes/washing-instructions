---
// The committed chart, never the gitignored one a household keeps for
// itself — the site has no per-visitor upload yet (that is #46). Vite
// resolves both statically at build time, unlike a path built from
// import.meta.url, which breaks once Rollup relocates this page's chunk.
import machineSource from "../../../../data/machine.json.dist?raw";
import csvSource from "../../../../data/washing-instructions.csv.dist?raw";
import Logo from "../components/Logo.astro";
import SheetViewer from "../components/SheetViewer";
import Layout from "../layouts/Layout.astro";
import { buildChart } from "../lib/chart";

const { items, machine } = buildChart(csvSource, machineSource);
---

<Layout
  title="Washy washy"
  description="A phone-friendly laundry chart: programme, temperature and spin for every pile, what can share a drum, and where the iron's thermostat goes."
>
  <div class="mb-2 flex items-center gap-2">
    <Logo />
    <h1 class="text-2xl font-bold text-ink sm:text-3xl">Washy washy</h1>
  </div>
  <p class="mb-6 text-base text-body">
    Turns a laundry chart into a phone-friendly sheet: which programme, temperature and spin for
    each pile, what can share a drum, and where the iron's thermostat goes. Add this page to your
    phone's home screen — Safari's Share menu or Chrome's <em>⋮</em> menu both have an "Add to
    Home Screen" option — and it opens like an app, no address bar, right by the machine.
  </p>
  <SheetViewer client:load items={items} machine={machine} />
</Layout>
